# ---------------------------------------------------------------------------
# MGA lead-magnet backend -- copy to .env (repo root or backend/) and fill in.
# See README.md for what each piece does.
# ---------------------------------------------------------------------------

# --- LLM personalization (optional) -----------------------------------------
# Any OpenAI-compatible endpoint. Used to personalize each lead's report.
# Without OPENAI_API_KEY a deterministic template is used instead, so the
# pipeline still works end to end.
OPENAI_API_KEY=your-api-key-here
OPENAI_BASE_URL=https://your-llm-endpoint/v1
LLM_MODEL=auto

# --- Email: report delivery + team notifications ----------------------------
# MailerLite (default EMAIL_PROVIDER). MAILERLITE_API_TOKEN is a Bearer API
# token from MailerLite -> Integrations -> Developer API -> "Generate new
# token" -- NOT your account email/password.
MAILERLITE_API_TOKEN=your-mailerlite-api-token-here
# Must already be a verified sender address on your MailerLite account, or
# live sends will fail with "MailerLite sender email is not verified."
MAILERLITE_SENDER_EMAIL=your-verified-sender@yourdomain.com
MAILERLITE_SENDER_NAME=My Growth Academy

# "mailerlite" (default) or "gmail".
EMAIL_PROVIDER=mailerlite

# Master safety switch: no real email is ever sent unless this is true.
# Leave false for local dev and automated tests. When false, leads are
# still processed and their PDF is still downloadable -- only the emails
# are skipped (recorded as email_sent=false on the lead).
PROSPECT_ALLOW_LIVE_SEND=false

# Gmail/SMTP -- only used if EMAIL_PROVIDER=gmail. Needs a 16-character
# Gmail App Password (Google Account -> Security -> 2-Step Verification ->
# App passwords), not your normal password. Unlike MailerLite, Gmail can
# attach the PDF to the delivery email.
GMAIL_ADDRESS=your-account@gmail.com
GMAIL_APP_PASSWORD=xxxxxxxxxxxxxxxx

# Who gets an email every time someone submits the website quiz (or the
# Google Form). Comma-separated; leave empty to turn off. The email has the
# lead's name, email, phone, all their answers and a link to the PDF they
# got. Only sends when PROSPECT_ALLOW_LIVE_SEND=true. Sent once per lead,
# never on retries, and a failed notification never affects the lead.
LEAD_NOTIFY_EMAILS=

# --- Website + public URLs ---------------------------------------------------
# Origins allowed to call this API from a browser (comma-separated). Add
# the website's real deployed origin (e.g. https://mygrowthacademy.coach)
# so POST /api/leads/website works in production -- see config.py's
# CORS_ORIGINS for the local-dev defaults.
PROSPECT_CORS_ORIGINS=

# This backend's own public HTTPS URL, embedded in the lead-magnet download
# link. Defaults to http://localhost:8000 -- MUST be set to the real public
# URL before going live.
PUBLIC_API_BASE_URL=

# --- Storage -------------------------------------------------------------------
# SQLite file holding the leads. Defaults to data/pipeline_state.db.
PROSPECT_DB_PATH=
# Where generated lead-magnet PDFs are written. Defaults to
# data/mga_lead_magnets/.
MGA_LEAD_MAGNET_DIR=

# --- Optional Google Form path -------------------------------------------------
# Shared secret the Google Apps Script (google-apps-script/Code.gs) sends in
# the X-MGA-Webhook-Secret header. Only needed if you use the Google Form
# path -- the website quiz posts to POST /api/leads/website and does not
# use it. Also required by the dashboard's "Retry" button. Unset = the
# webhook refuses every request. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
GOOGLE_FORM_WEBHOOK_SECRET=

# --- Dashboard access ----------------------------------------------------------
# Key required to use the admin dashboard (frontend/index.html) and every
# dashboard API route -- these expose lead names, emails and phone numbers.
# Required: if unset, the dashboard routes are locked (HTTP 503). Paste the
# same value into the "Dashboard key" box at the top right of the dashboard.
# The public routes the website needs (quiz submission, PDF download,
# health check) never need it. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
DASHBOARD_API_KEY=

# Local development only: set to true to skip the dashboard key entirely.
# NEVER set this on a server reachable from the internet.
DASHBOARD_AUTH_DISABLED=false

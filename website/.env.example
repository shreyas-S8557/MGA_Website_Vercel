# Base URL of the MGA lead-magnet backend (FastAPI service). Used
# directly by the browser now: LeadMagnetModal.tsx's on-page lead-magnet
# quiz POSTs straight to `${NEXT_PUBLIC_API_URL}/api/leads/website` and
# gets a personalized-PDF download link back in the same response — there
# is no Google Form / Apps Script hop anymore. Make sure this origin is
# added to the backend's PROSPECT_CORS_ORIGINS (see the repo root
# .env.example) or the browser POST will be blocked by CORS.
NEXT_PUBLIC_API_URL=https://api.mygrowthacademy.coach

# Site URL used for canonical/OG metadata.
NEXT_PUBLIC_SITE_URL=https://mygrowthacademy.coach

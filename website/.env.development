# Used by `npm run dev` only (Next.js loads .env.development automatically).
# Points the quiz at the backend running on your own machine:
#   cd backend && uvicorn app.main:app --port 8000
# Production builds ignore this file and use NEXT_PUBLIC_API_URL from
# Vercel project settings instead (see .env.example).
NEXT_PUBLIC_API_URL=http://localhost:8000
